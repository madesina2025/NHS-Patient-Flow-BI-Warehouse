        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\SQL Commit Historical Staging"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{417FE49A-C6BC-4C19-998B-8B2EB0D8AA25}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL Commit Historical Staging"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{E5587F3B-591C-4738-9386-BDCFF6A66135}"
              SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT Period&#xA;    FROM stg.RTT_Raw_Work&#xA;    GROUP BY Period&#xA;    HAVING COUNT(*) &lt;&gt;&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM stg.RTT_Clean_Work&#xA;        WHERE reporting_period =&#xA;              UPPER(stg.RTT_Raw_Work.Period)&#xA;    )&#xA;)&#xA;BEGIN&#xA;    THROW 50001,&#xA;          'RAW and CLEAN row counts do not match. Commit cancelled.',&#xA;          1;&#xA;END;&#xA;&#xA;    -- Preserve historical RAW records.&#xA;    -- Only insert reporting periods not already present.&#xA;    INSERT INTO stg.RTT_Raw&#xA;    SELECT w.*&#xA;    FROM stg.RTT_Raw_Work AS w&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM stg.RTT_Raw AS h&#xA;        WHERE h.Period = w.Period&#xA;    );&#xA;&#xA;    -- Preserve historical CLEAN records.&#xA;    INSERT INTO stg.RTT_Clean&#xA;    SELECT w.*&#xA;    FROM stg.RTT_Clean_Work AS w&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM stg.RTT_Clean AS h&#xA;        WHERE h.reporting_period = w.reporting_period&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\SQL Update RTT Dimensions"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
