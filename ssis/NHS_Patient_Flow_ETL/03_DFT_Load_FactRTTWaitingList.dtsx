    <DTS:Executable
      DTS:refId="Package\End Audit Run - Success"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3D5EE549-B03A-4615-A063-16D93E9B82F5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="End Audit Run - Success"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D86A4E-F046-4B1C-BB33-7E04C8789C15}"
          SQLTask:SqlStatementSource="UPDATE audit.ETL_Run_Log&#xA;SET&#xA;    EndTime = SYSDATETIME(),&#xA;    RowsLoaded = (&#xA;        SELECT COUNT(*)&#xA;        FROM dw.FactRTTWaitingList&#xA;    ),&#xA;    RunStatus = 'Success',&#xA;    ErrorMessage = NULL&#xA;WHERE RunID = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::AuditRunID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Final Fact"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{08B1919F-B4BC-4C9F-92FB-34A35AF4291A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Final Fact"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D86A4E-F046-4B1C-BB33-7E04C8789C15}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Stop the load if staging contains duplicate fact keys&#xA;    IF EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM stg.RTT_FactLoad&#xA;        GROUP BY&#xA;            ReportingPeriodKey,&#xA;            ProviderKey,&#xA;            CommissionerKey,&#xA;            TreatmentFunctionKey,&#xA;            RTTPartType&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;    BEGIN&#xA;        THROW 50001, 'Duplicate fact grain detected in staging.', 1;&#xA;    END;&#xA;&#xA;    -- Update existing fact records&#xA;    UPDATE f&#xA;    SET&#xA;        f.TotalWaiting = s.TotalWaiting,&#xA;        f.TotalAll = s.TotalAll,&#xA;        f.UnknownClockStartCount = s.UnknownClockStartCount,&#xA;        f.WaitsUnder18Weeks = s.WaitsUnder18Weeks,&#xA;        f.WaitsOver18Weeks = s.WaitsOver18Weeks,&#xA;        f.WaitsOver52Weeks = s.WaitsOver52Weeks&#xA;    FROM dw.FactRTTWaitingList AS f&#xA;    INNER JOIN stg.RTT_FactLoad AS s&#xA;        ON f.ReportingPeriodKey = s.ReportingPeriodKey&#xA;       AND f.ProviderKey = s.ProviderKey&#xA;       AND f.CommissionerKey = s.CommissionerKey&#xA;       AND f.TreatmentFunctionKey = s.TreatmentFunctionKey&#xA;       AND f.RTTPartType = s.RTTPartType;&#xA;&#xA;    -- Insert records not already in the fact table&#xA;    INSERT INTO dw.FactRTTWaitingList&#xA;    (&#xA;        ReportingPeriodKey,&#xA;        ProviderKey,&#xA;        CommissionerKey,&#xA;        TreatmentFunctionKey,&#xA;        RTTPartType,&#xA;        TotalWaiting,&#xA;        TotalAll,&#xA;        UnknownClockStartCount,&#xA;        WaitsUnder18Weeks,&#xA;        WaitsOver18Weeks,&#xA;        WaitsOver52Weeks&#xA;    )&#xA;    SELECT&#xA;        s.ReportingPeriodKey,&#xA;        s.ProviderKey,&#xA;        s.CommissionerKey,&#xA;        s.TreatmentFunctionKey,&#xA;        s.RTTPartType,&#xA;        s.TotalWaiting,&#xA;        s.TotalAll,&#xA;        s.UnknownClockStartCount,&#xA;        s.WaitsUnder18Weeks,&#xA;        s.WaitsOver18Weeks,&#xA;        s.WaitsOver52Weeks&#xA;    FROM stg.RTT_FactLoad AS s&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM dw.FactRTTWaitingList AS f WITH (UPDLOCK, HOLDLOCK)&#xA;        WHERE f.ReportingPeriodKey = s.ReportingPeriodKey&#xA;          AND f.ProviderKey = s.ProviderKey&#xA;          AND f.CommissionerKey = s.CommissionerKey&#xA;          AND f.TreatmentFunctionKey = s.TreatmentFunctionKey&#xA;          AND f.RTTPartType = s.RTTPartType&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Start Audit Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{691F86BB-E6DA-470F-AB7E-54738F85AC49}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Start Audit Run"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D86A4E-F046-4B1C-BB33-7E04C8789C15}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO audit.ETL_Run_Log&#xA;(&#xA;    PackageName,&#xA;    StartTime,&#xA;    RunStatus&#xA;)&#xA;VALUES&#xA;(&#xA;    '03_DFT_Load_FactRTTWaitingList.dtsx',&#xA;    SYSDATETIME(),&#xA;    'Running'&#xA;);&#xA;SELECT CAST(SCOPE_IDENTITY() AS INT) AS AuditRunID;&#xA;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::AuditRunID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Validate Fact Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6B91FF77-6426-445E-9FBB-B7F20A9AB32E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Validate Fact Staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D86A4E-F046-4B1C-BB33-7E04C8789C15}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @SourceRows BIGINT;&#xA;DECLARE @StagingRows BIGINT;&#xA;&#xA;SELECT @SourceRows = COUNT_BIG(*)&#xA;FROM stg.RTT_Clean_Work;&#xA;&#xA;SELECT @StagingRows = COUNT_BIG(*)&#xA;FROM stg.RTT_FactLoad;&#xA;&#xA;IF @SourceRows &lt;&gt; @StagingRows&#xA;BEGIN&#xA;    THROW 50002,&#xA;        'Fact staging row count does not match current clean working batch.',&#xA;        1;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
